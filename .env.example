# Copy this file to .env.local for local development, or set in Vercel Dashboard → Environment Variables.

# QQ / Foxmail SMTP credentials (used by Nodemailer)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=sistian@foxmail.com
SMTP_PASS=your_qq_or_foxmail_16_char_auth_code

# Legacy alias, also accepted if SMTP_PASS is not set
QQ_AUTH_CODE=your_qq_or_foxmail_16_char_auth_code

# Where notifications are sent
ADMIN_EMAIL=sistian@foxmail.com

# Optional: BCC every notification to another address
# BCC_EMAIL=backup@example.com

# Optional: send a confirmation copy to the customer
SEND_CUSTOMER_COPY=true

# Optional: restrict CORS to your frontend domain
FRONTEND_URL=https://www.ChinaWiFiGo.com

# Admin read-only order list API
# ADMIN_TOKEN=your_secret_random_token
